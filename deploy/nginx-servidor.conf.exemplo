# Exemplo de site no nginx do servidor (fora do contêiner). Troque SEU.DOMINIO.
# O certificado é emitido pelo certbot, que acrescenta o bloco 443.

limit_req_zone $binary_remote_addr zone=jogosus:10m rate=20r/s;

server {
  listen 80;
  listen [::]:80;
  server_name SEU.DOMINIO;

  access_log /var/log/nginx/jogo-sus.access.log;
  error_log /var/log/nginx/jogo-sus.error.log;

  client_max_body_size 1k;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    limit_req zone=jogosus burst=40 nodelay;
    limit_except GET HEAD { deny all; }
    # IP fixo do contêiner na rede interna definida em deploy/compose.yml.
    proxy_pass http://10.250.250.2:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
